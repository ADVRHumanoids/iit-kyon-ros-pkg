<launch>

    <arg name="rate" default="100.0"/>
    <arg name="prefix" default=""/>
    <arg name="ik" default="$(find cetc_sat_cartesio)/config/cetc_sat_stack.yaml"/>
    <arg name="arms" default="true"/>
    <arg name="legs" default="true"/>
    <arg name="sensors" default="false"/>
    
    <param name="robot_description"
        command="$(find xacro)/xacro $(find cetc_sat_urdf)/urdf/cetc_sat.urdf.xacro floating_joint:=false upper_body:=$(arg arms) legs:=$(arg legs) velodyne:=$(arg velodyne) front_d435:=$(arg front_d435) front_d455:=$(arg front_d455) front_zed:=$(arg front_zed) lateral_realsense:=$(arg lateral_realsense) lateral_zed:=$(arg lateral_zed)"/>
    
    <param name="robot_description_semantic"
        command="$(find xacro)/xacro $(find cetc_sat_srdf)/srdf/cetc_sat.srdf.xacro floating_joint:=true upper_body:=$(arg arms) legs:=$(arg legs) sensors:=$(arg sensors)"/>
    
    <param name="cartesian/problem_description" 
        textfile="$(arg ik)"/>
    

    <include file="$(find cartesian_interface)/launch/cartesio.launch">
        <arg name="rate" value="$(arg rate)"/>
        <arg name="prefix" value="$(arg prefix)"/>
    </include>
    
</launch>
