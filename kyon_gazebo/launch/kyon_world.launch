<launch>
        
    <arg name="gazebo" default="true"/>

    <!-- gazebo configuration parameters -->
    <arg name="paused" default="false"/>
    <arg name="use_sim_time" default="true"/>
    <arg name="gui" default="true"/>
    <arg name="headless" default="false"/>
    <arg name="debug" default="false"/>
    <arg name="physics" default="ode"/>
    <arg name="verbose" default="false"/>
    <arg name="extra_gazebo_args" default=""/>
    
    <!-- kyon configuration parameters -->
    <arg name="arms" default="true"/>
    <arg name="legs" default="true"/>
    <arg name="payload" default="false"/>
    <arg name="wheels" default="false"/>
    <arg name="velodyne" default="false"/>
    <arg name="hesai_jt128" default="false"/>
    <!-- Hesai QT128 on imu_link (default: lio_mapping's calibrated extrinsic), as the real driver's
         cloud on /lidar_points (sim_hesai_adapter, motion distortion from /sim/ground_truth) -->
    <arg name="hesai_qt128" default="false"/>
    <arg name="hesai_qt128_x" default="0.6862"/>
    <arg name="hesai_qt128_y" default="0.0"/>
    <arg name="hesai_qt128_z" default="-0.015"/>
    <arg name="hesai_qt128_roll" default="3.141592653589793"/>
    <arg name="hesai_qt128_pitch" default="0.0"/>
    <arg name="hesai_qt128_yaw" default="-2.0928021889929584"/>
    <arg name="camera_front_up" default="false"/>
    <arg name="camera_front_down" default="false"/>


    <!-- Internal arguments, rewrite human-readable gazebo arguments to it's internal arguments -->
    <let name="arg_paused" value="-r" unless="$(var paused)"/>
    <let name="arg_paused" value="" if="$(var paused)"/>

    <let name="arg_verbose" value="" unless="$(var verbose)" />
    <let name="arg_verbose" value="--verbose" if="$(var verbose)" />

    <let name="arg_gui" value="-s" unless="$(var gui)"/> 
    <let name="arg_gui" value="" if="$(var gui)"/> 

    <let name="script_type" value="gzserver" unless="$(var debug)"/>
    <let name="script_type" value="debug" if="$(var debug)"/>

    <!-- run gazebo -->
    <group if="$(var gazebo)">
  
       <!-- from where the simulation enviornment will be loaded:
              WARNING: exactly one parameter has to be true, otherwise simulation behaviour is undefined -->
       <arg name="world_name" default="$(find-pkg-share kyon_gazebo)/worlds/kyon.world"/>
       
       <!-- Load the URDF/SRDF into the ROS Parameter Server -->
       <let name="robot_description_gz"
            value="$(command 'xacro $(find-pkg-share kyon_gazebo)/urdf/kyon_gazebo.urdf.xacro floating_joint:=false upper_body:=$(var arms) legs:=$(var legs) payload:=$(var payload) wheels:=$(var wheels) velodyne:=$(var velodyne) hesai_jt128:=$(var hesai_jt128) hesai_qt128:=$(var hesai_qt128) hesai_qt128_x:=$(var hesai_qt128_x) hesai_qt128_y:=$(var hesai_qt128_y) hesai_qt128_z:=$(var hesai_qt128_z) hesai_qt128_roll:=$(var hesai_qt128_roll) hesai_qt128_pitch:=$(var hesai_qt128_pitch) hesai_qt128_yaw:=$(var hesai_qt128_yaw) ground_truth:=$(var hesai_qt128) camera_front_up:=$(var camera_front_up) camera_front_down:=$(var camera_front_down)')"/>
 
       <!-- Start gazebo-->
       <include file="$(find-pkg-share ros_gz_sim)/launch/gz_sim.launch.py">
              <arg name="gz_args" value="$(var world_name) $(var arg_verbose) $(var arg_gui) $(var arg_paused)"/>
       </include>

       <!-- Spawn URDF model-->
       <node pkg="ros_gz_sim" exec="create" name="urdf_spawner">
              <param name="string" type="str" value="$(var robot_description_gz)"/>
              <param name="z" value="1.0"/>
       </node>

       <!-- ROS-gazebo topics bridge-->
       <node pkg="ros_gz_bridge" exec="parameter_bridge" name="ros_gz_bridge"
            args="
             /hesai_lidar/points@sensor_msgs/msg/PointCloud2[gz.msgs.PointCloudPacked
             /hesai_lidar@sensor_msgs/msg/LaserScan[gz.msgs.LaserScan
             /hesai_jt128_front/points@sensor_msgs/msg/PointCloud2[gz.msgs.PointCloudPacked
             /hesai_jt128_back/points@sensor_msgs/msg/PointCloud2[gz.msgs.PointCloudPacked
             /hesai_qt128/points@sensor_msgs/msg/PointCloud2[gz.msgs.PointCloudPacked
             /clock@rosgraph_msgs/msg/Clock[gz.msgs.Clock 
             /zed_front_up/image@sensor_msgs/msg/Image[gz.msgs.Image
             /zed_front_up/depth_image@sensor_msgs/msg/Image[gz.msgs.Image
             /zed_front_up/camera_info@sensor_msgs/msg/CameraInfo[gz.msgs.CameraInfo
             /zed_front_up/points@sensor_msgs/msg/PointCloud2[gz.msgs.PointCloudPacked
             /zed_front_down/image@sensor_msgs/msg/Image[gz.msgs.Image
             /zed_front_down/depth_image@sensor_msgs/msg/Image[gz.msgs.Image
             /zed_front_down/camera_info@sensor_msgs/msg/CameraInfo[gz.msgs.CameraInfo
             /zed_front_down/points@sensor_msgs/msg/PointCloud2[gz.msgs.PointCloudPacked
             "/> 

       <group if="$(var hesai_qt128)">
              <node pkg="ros_gz_bridge" exec="parameter_bridge" name="ground_truth_bridge"
                     args="/sim/ground_truth@nav_msgs/msg/Odometry[gz.msgs.Odometry"/>
              <!-- XBot2's model has no hesai_qt128 -->
              <node pkg="tf2_ros" exec="static_transform_publisher" name="hesai_qt128_tf"
                     args="--frame-id imu_link --child-frame-id hesai_qt128 --x $(var hesai_qt128_x) --y $(var hesai_qt128_y) --z $(var hesai_qt128_z) --roll $(var hesai_qt128_roll) --pitch $(var hesai_qt128_pitch) --yaw $(var hesai_qt128_yaw)">
                     <param name="use_sim_time" value="true"/>
              </node>
              <node pkg="kyon_gazebo" exec="sim_hesai_adapter" name="sim_hesai_adapter">
                     <param from="$(find-pkg-share kyon_gazebo)/config/sim_hesai_adapter.yaml"/>
                     <param name="use_sim_time" value="true"/>
              </node>
       </group>
            
    </group>

       <!-- Load the URDF/SRDF into the ROS Parameter Server -->
    <let name="urdf_command"
        value="xacro $(find-pkg-share kyon_urdf)/urdf/kyon_robot.urdf.xacro floating_joint:=true upper_body:=$(var arms) legs:=$(var legs) payload:=$(var payload) wheels:=$(var wheels) velodyne:=$(var velodyne) hesai_jt128:=$(var hesai_jt128)"/>

    <let name="urdf_string"
        value="$(command '$(var urdf_command)' ignore)"/>

    <let name="srdf_command"
        value="xacro $(find-pkg-share kyon_srdf)/srdf/kyon.srdf.xacro floating_joint:=true upper_body:=$(var arms) legs:=$(var legs) payload:=$(var payload) wheels:=$(var wheels) velodyne:=$(var velodyne)"/>

    <let name="srdf_string"
        value="$(command '$(var srdf_command)' ignore)"/>

    <node pkg="xbot2_ros" exec="robot_description_publisher" name="robot_description_publisher" output="screen">
        <param name="robot_description" value="$(var urdf_string)" type="str"/>
        <param name="robot_description_semantic" value="$(var srdf_string)" type="str"/>
    </node>

</launch>
