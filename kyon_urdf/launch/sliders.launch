<launch>

    <arg name="gui" default="true" />

    <!-- kyon configuration parameters -->
    <arg name="arms" default="false" />
    <arg name="legs" default="true" />
    <arg name="feet" default="true" />
    <arg name="sensors" default="false" />
    <arg name="dagana" default="false" />
    <arg name="velodyne" default="false" />
    <arg name="wheels" default="false" />
    <arg name="ft_sensors" default="true" />

    <!-- URDF and SRDF commands -->
    <let name="urdf_command"
        value="xacro $(find-pkg-share kyon_urdf)/urdf/kyon_robot.urdf.xacro floating_joint:=true upper_body:=$(var arms) legs:=$(var legs) dagana:=$(var dagana) wheels:=$(var wheels) velodyne:=$(var velodyne)"/>

    <let name="urdf_string"
        value="$(command '$(var urdf_command)' ignore)"/>

    <let name="srdf_command"
        value="xacro $(find-pkg-share kyon_srdf)/srdf/kyon.srdf.xacro floating_joint:=true upper_body:=$(var arms) legs:=$(var legs) dagana:=$(var dagana) wheels:=$(var wheels) velodyne:=$(var velodyne)"/>

    <let name="srdf_string"
        value="$(command '$(var srdf_command)' ignore)"/>

    <!-- Launch robot description -->
    <node pkg="robot_state_publisher"  exec="robot_state_publisher" name="robot_state_publisher">

        <param name="robot_description" value="$(var urdf_string)" type="str"/>

    </node>

    <group if="$(var gui)">
        
        <node pkg="joint_state_publisher_gui"  exec="joint_state_publisher_gui" name="joint_state_publisher_gui"/>

        <node pkg="rviz2"  exec="rviz2" name="rviz2" args="-d $(find-pkg-share kyon_urdf)/config/kyon.rviz"/>

    </group>

    <node pkg="xbot2_ros" exec="robot_description_publisher" name="robot_description_publisher" output="screen">
        <param name="robot_description" value="$(var urdf_string)" type="str"/>
        <param name="robot_description_semantic" value="$(var srdf_string)" type="str"/>
    </node>

</launch>