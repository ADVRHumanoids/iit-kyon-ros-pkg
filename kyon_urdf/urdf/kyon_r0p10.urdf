      </geometry>
    </collision>
  </link>
  <link name="lower_leg_4">
    <inertial>
      <origin xyz="0.15 0.0 0.0"/>
      <mass value="1.0"/>
      <inertia ixx="0.00041666666666666675" ixy="0.0" ixz="0.0" iyy="0.007708333333333333" iyz="0.0" izz="0.007708333333333333"/>
    </inertial>
    <visual>
      <origin rpy="0.0 0.0 0.0" xyz="0.15 0.0 0.0"/>
      <geometry>
        <box size="0.3 0.05 0.05"/>
      </geometry>
      <material name="dark_grey"/>
    </visual>
    <collision>
      <origin rpy="0.0 0.0 0.0" xyz="0.15 0.0 0.0"/>
      <geometry>
        <box size="0.3 0.05 0.05"/>
      </geometry>
    </collision>
  </link>
  <link name="ball_4">
    <inertial>
      <origin xyz="0.0 0.0 0.0"/>
      <mass value="0.1"/>
      <inertia ixx="0.0001666666666666667" ixy="0.0" ixz="0.0" iyy="0.0001666666666666667" iyz="0.0" izz="0.0001666666666666667"/>
    </inertial>
    <visual>
      <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
      <geometry>
        <sphere radius="0.05"/>
      </geometry>
    </visual>
    <collision>
      <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
      <geometry>
        <sphere radius="0.05"/>
      </geometry>
    </collision>
  </link>
  <!-- joints -->
  <joint name="hip_roll_4" type="revolute">
    <parent link="pelvis"/>
    <child link="hip_roll_motor_4"/>
    <origin rpy="0.0 1.57079632679 0.0" xyz="-0.4 -0.225 0.0"/>
    <axis xyz="0 0 1"/>
    <limit effort="132" lower="-2.03" upper="2.51" velocity="15.5"/>
    <!-- 200 Nm, 1 rad/s-->
  </joint>
  <joint name="hip_pitch_stator_4" type="fixed">
    <parent link="hip_roll_motor_4"/>
    <child link="hip_pitch_motor_4"/>
    <origin rpy="-1.57079632679 0.0 0.0" xyz="0.0 -0.07 0.0"/>
  </joint>
  <joint name="knee_pitch_stator_4" type="fixed">
    <parent link="hip_pitch_motor_4"/>
    <child link="knee_pitch_motor_4"/>
    <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
  </joint>
  <joint name="hip_pitch_4" type="revolute">
    <parent link="hip_pitch_motor_4"/>
    <child link="upper_leg_4"/>
    <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
    <axis xyz="0 0 1"/>
    <limit effort="132" lower="-2.3426" upper="2.3426" velocity="15.5"/>
    <!-- 200 Nm, 1 rad/s-->
  </joint>
  <joint name="knee_pitch_4" type="revolute">
    <parent link="upper_leg_4"/>
    <child link="lower_leg_4"/>
    <origin rpy="0.0 0.0 0.0" xyz="0.35 0.0 0.0"/>
    <axis xyz="0 0 1"/>
    <limit effort="132" lower="-2.3426" upper="2.3426" velocity="15.5"/>
    <!-- 200 Nm, 1 rad/s-->
  </joint>
  <joint name="ball_joint_4" type="fixed">
    <parent link="lower_leg_4"/>
    <child link="ball_4"/>
    <origin rpy="0.0 0.0 0.0" xyz="0.3 0.0 0.0"/>
  </joint>
  <!-- ************ Control frames ************ -->
  <!--xacro:include filename="$(find pholus_urdf)/urdf/control_frames.urdf.xacro"/-->
  <link name="world"/>
  <joint name="reference" type="floating">
    <parent link="world"/>
    <child link="pelvis"/>
  </joint>
</robot>
