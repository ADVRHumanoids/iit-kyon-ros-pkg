<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro" name="kyon">

  <!-- Define PACKAGE_ROOT as a xacro argument with a default value -->
  <xacro:arg name="PACKAGE_ROOT" default="$(find kyon_urdf)" />

  <xacro:include filename="${KYON_ROOT}/urdf/kyon.urdf.xacro" />

  <xacro:include filename="${KYON_ROOT}/urdf/gazebo/kyon.gazebo.xacro" />
   
  <xacro:include filename="${KYON_ROOT}/urdf/gazebo/xbot.gazebo.xacro" />

  <xacro:include filename="${KYON_ROOT}/urdf/gazebo/materials.gazebo.xacro" />
  
  <xacro:unless value="${ADD_LEGS}">

    <link name="world"/>
      <joint name="reference" type="fixed">
      <parent link="world"/>
      <child link="pelvis"/>
    </joint>

  </xacro:unless>

  <origin xyz="0.0 0.0 1.2" rpy="0 0 0" />
</robot>
