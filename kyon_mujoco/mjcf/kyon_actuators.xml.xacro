<?xml version="1.0"?>
<mujoco xmlns:xacro="http://ros.org/wiki/xacro">

    <actuator>

        <!-- legs -->
        <position class="kyon_leg" name="hip_roll_1" joint="hip_roll_1" />
        <position class="kyon_leg" name="hip_pitch_1" joint="hip_pitch_1" />
        <position class="kyon_leg" name="knee_pitch_1" joint="knee_pitch_1" />

        <xacro:if value="${ADD_WHEELS}">
            <position class="kyon_ankle" name="ankle_yaw_1" joint="ankle_yaw_1" />
            <position class="kyon_wheel" name="wheel_joint_1" joint="wheel_joint_1" />
        </xacro:if>

        <position class="kyon_leg" name="hip_roll_2" joint="hip_roll_2" />
        <position class="kyon_leg" name="hip_pitch_2" joint="hip_pitch_2" />
        <position class="kyon_leg" name="knee_pitch_2" joint="knee_pitch_2" />

        <xacro:if value="${ADD_WHEELS}">
            <position class="kyon_ankle" name="ankle_yaw_2" joint="ankle_yaw_2" />
            <position class="kyon_wheel" name="wheel_joint_2" joint="wheel_joint_2" />
        </xacro:if>

        <position class="kyon_leg" name="hip_roll_3" joint="hip_roll_3" />
        <position class="kyon_leg" name="hip_pitch_3" joint="hip_pitch_3" />
        <position class="kyon_leg" name="knee_pitch_3" joint="knee_pitch_3" />

        <xacro:if value="${ADD_WHEELS}">
            <position class="kyon_ankle" name="ankle_yaw_3" joint="ankle_yaw_3" />
            <position class="kyon_wheel" name="wheel_joint_3" joint="wheel_joint_3" />
        </xacro:if>

        <position class="kyon_leg" name="hip_roll_4" joint="hip_roll_4" />
        <position class="kyon_leg" name="hip_pitch_4" joint="hip_pitch_4" />
        <position class="kyon_leg" name="knee_pitch_4" joint="knee_pitch_4" />

        <xacro:if value="${ADD_WHEELS}">
            <position class="kyon_ankle" name="ankle_yaw_4" joint="ankle_yaw_4" />
            <position class="kyon_wheel" name="wheel_joint_4" joint="wheel_joint_4" />
        </xacro:if>
        
        <!-- arms -->
        <xacro:if value="${ADD_UPPER_BODY}">
            <position class="kyon_arm" name="shoulder_yaw_1" joint="shoulder_yaw_1" />
            <position class="kyon_arm" name="shoulder_pitch_1" joint="shoulder_pitch_1" />
            <position class="kyon_arm" name="elbow_pitch_1" joint="elbow_pitch_1" />
            <position class="kyon_arm" name="wrist_pitch_1" joint="wrist_pitch_1" />
            <position class="kyon_arm" name="wrist_yaw_1" joint="wrist_yaw_1" />
            <position class="kyon_dagana" name="dagana_1_clamp_joint" joint="dagana_1_clamp_joint" />

            <position class="kyon_arm" name="shoulder_yaw_2" joint="shoulder_yaw_2" />
            <position class="kyon_arm" name="shoulder_pitch_2" joint="shoulder_pitch_2" />
            <position class="kyon_arm" name="elbow_pitch_2" joint="elbow_pitch_2" />
            <position class="kyon_arm" name="wrist_pitch_2" joint="wrist_pitch_2" />
            <position class="kyon_arm" name="wrist_yaw_2" joint="wrist_yaw_2" />
            <position class="kyon_dagana" name="dagana_2_clamp_joint" joint="dagana_2_clamp_joint" />
        </xacro:if>

    </actuator>

</mujoco>