<mujoco>
    <!-- world.xml plus primitives at known poses, for the lidar (kyon_world.launch lidar:=true).
         Floor at z -1 as in world.xml; the robot spawns at the origin facing +x. -->
    <extension>
        <plugin plugin="mujoco.sdf.torus">
            <instance name="torus">
                <config key="radius1" value="0.077103"/>
                <config key="radius2" value="0.03"/>
            </instance>
        </plugin>
    </extension>

    <asset>
        <mesh name="torus">
            <plugin instance="torus"/>
        </mesh>

        <texture type="skybox" builtin="gradient" rgb1=".3 .5 .7" rgb2="0 0 0" width="512" height="512"/>
        <texture name="grid" type="2d" builtin="checker" width="512" height="512" rgb1=".1 .2 .3" rgb2=".2 .3 .4"/>
        <material name="grid" texture="grid" texrepeat="1 1" texuniform="true" reflectance=".2"/>
        <material name="obstacle" rgba=".8 .6 .4 1"/>
    </asset>
    <worldbody>
        <geom name="floor_0" size="0 0 .05" pos="0 0 -1.0" type="plane" material="grid" condim="3" group="0" friction="0.6"/>
        <geom name="floor_1" size="0 0 .05" pos="0 0 -1.0" type="plane" material="grid" condim="3" group="1" friction="0.6"/>

        <!-- 1 m cube, near face at x 2.5 -->
        <geom name="cube" type="box" pos="3 0 -0.5" size=".5 .5 .5" material="obstacle" group="0"/>
        <!-- 2 m high wall behind, face at x -4 -->
        <geom name="wall" type="box" pos="-4.1 0 0" size=".1 4 1" material="obstacle" group="0"/>
        <!-- 0.6 m diameter pole on the left -->
        <geom name="pole" type="cylinder" pos="0 3 -0.25" size=".3 .75" material="obstacle" group="0"/>
        <!-- 15 cm step and a 15 deg ramp on the right -->
        <geom name="step" type="box" pos="-1.5 -2.5 -0.925" size=".5 .5 .075" material="obstacle" group="0"/>
        <geom name="ramp" type="box" pos="2 -3 -1" euler="0 -0.2618 0" size="1.5 .75 .2" material="obstacle" group="0"/>
    </worldbody>
    <visual>
        <headlight ambient="0.5 0.5 0.5"/>
    </visual>
</mujoco>
