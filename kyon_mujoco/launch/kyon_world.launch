<launch>

    <arg name="world" default="$(find-pkg-share kyon_mujoco)/world/world.xml" />
    <arg name="urdf" default="$(find-pkg-share kyon_urdf)/urdf/kyon.urdf.xacro" />
    <arg name="srdf" default="$(find-pkg-share kyon_srdf)/srdf/kyon.srdf.xacro" />

    <!-- kyon configuration parameters -->
    <arg name="arms" default="true" />
    <arg name="legs" default="true" />
    <arg name="sensors" default="false" />
    <arg name="payload" default="false" />
    <arg name="dagana" default="false" />
    <arg name="feet" default="true" />
    <arg name="wheels" default="false" />
    <arg name="steering_wheels" default="false" />
    <arg name="varta" default="true" />
    <arg name="ft_sensors" default="true" />
    <arg name="velodyne" default="false" />

    <!-- Load the URDF/SRDF into the ROS Parameter Server -->
    <let name="urdf_command"
        value="xacro $(find-pkg-share kyon_urdf)/urdf/kyon_robot.urdf.xacro floating_joint:=true upper_body:=$(var arms) legs:=$(var legs) sensors:=$(var sensors) payload:=$(var payload) varta:=$(var varta) dagana:=$(var dagana) feet:=$(var feet) wheels:=$(var wheels) steering_wheels:=$(var steering_wheels) ft_sensors:=$(var ft_sensors) velodyne:=$(var velodyne)" />

    <let name="srdf_command"
        value="xacro $(find-pkg-share kyon_srdf)/srdf/kyon.srdf.xacro floating_joint:=true upper_body:=$(var arms) legs:=$(var legs) sensors:=$(var sensors) payload:=$(var payload) dagana:=$(var dagana) feet:=$(var feet) wheels:=$(var wheels) steering_wheels:=$(var steering_wheels) ft_sensors:=$(var ft_sensors) velodyne:=$(var velodyne)" />

    <let name="cfg_xml_command"
        value="xacro $(find-pkg-share kyon_mujoco)/mjcf/kyon_mujoco.xml.xacro floating_joint:=true upper_body:=$(var arms) legs:=$(var legs) sensors:=$(var sensors) payload:=$(var payload) varta:=$(var varta) dagana:=$(var dagana) feet:=$(var feet) wheels:=$(var wheels) steering_wheels:=$(var steering_wheels) ft_sensors:=$(var ft_sensors) velodyne:=$(var velodyne)" />

    <executable name="xbot2_mujoco" output="screen" cmd="python3 -m xbot2_py_mujoco.simulate
        --name kyon 
        --urdf-cmd $(var urdf_command) 
        --srdf-cmd $(var srdf_command)
        --xml-cmd $(var cfg_xml_command) 
        --xml $(var world)
        " >
        <env name="PYTHONUNBUFFERED" value="1" />
    </executable>


</launch>
