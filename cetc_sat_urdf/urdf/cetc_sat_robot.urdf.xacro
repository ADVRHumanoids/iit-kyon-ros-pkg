<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro" name="cetc_sat">
  <!--
  ROS urdf definition of the PHOLUS humanoid robot by Istituto Italiano di Tecnologia
  
  Author: Enrico Mingo
  
  This file groups files to use cetc_sat in GAZEBO
  
  -->
  <xacro:include filename="$(find cetc_sat_urdf)/urdf/cetc_sat.urdf.xacro" />

  <xacro:include filename="$(find cetc_sat_urdf)/urdf/gazebo/cetc_sat.gazebo.xacro" />
   
  <xacro:include filename="$(find cetc_sat_urdf)/urdf/gazebo/xbot.gazebo.xacro" />

  <xacro:include filename="$(find cetc_sat_urdf)/urdf/gazebo/materials.gazebo.xacro" />
  
  <xacro:unless value="${ADD_LEGS}">

    <link name="world"/>
      <joint name="reference" type="fixed">
      <parent link="world"/>
      <child link="pelvis"/>
    </joint>

  </xacro:unless>

  <origin xyz="0.0 0.0 1.2" rpy="0 0 0" />
</robot>

