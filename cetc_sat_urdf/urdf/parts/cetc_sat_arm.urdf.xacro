<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">

<!-- macro arms -->
<xacro:macro name="cetc_sat_arm" params="arm_num rot parent">
	
<!-- LINKS -->
<!-- shoulder yaw -->
<link name="shoulder_yaw_motor_${arm_num}">
	<inertial>
		<origin xyz="0.0 0.0 0.0"/>
		<mass value="${props_inertial['motorA_mass']}"/>
		<inertia ixx="${MotorA_xx}" ixy="${MotorA_xy}" ixz="${MotorA_xz}" iyy="${MotorA_yy}" iyz="${MotorA_yz}" izz="${MotorA_zz}"/>
	</inertial>
	<visual>
		<origin xyz="0.0 0.0 0.0"  rpy="0.0 0.0 0.0"/>
		<geometry>
			<cylinder radius="${props['cylinder_radius']}" length="${props['cylinder_length']}"/>
		</geometry>
		<material name="dark_grey"/>
	</visual>
	<collision>
		<origin xyz="0.0 0.0 0.0"  rpy="0.0 0.0 0.0"/>
		<geometry>
			<cylinder radius="${props['cylinder_radius']}" length="${props['cylinder_length']}"/>
		</geometry>
	</collision>
</link>

<link name="shoulder_pitch_motor_${arm_num}">
	<inertial>
		<origin xyz="0.0 0.0 0.0"/>
		<mass value="${props_inertial['motorA_mass']}"/>
		<inertia ixx="${MotorA_xx}" ixy="${MotorA_xy}" ixz="${MotorA_xz}" iyy="${MotorA_yy}" iyz="${MotorA_yz}" izz="${MotorA_zz}"/>
	</inertial>
	<visual>
		<origin xyz="0.0 0.0 0.0"  rpy="0.0 0.0 0.0"/>
	  	<geometry>
	 		<cylinder radius="${props['cylinder_radius']}" length="${props['cylinder_length']}"/>
	  	</geometry>
  		<material name="dark_grey"/>
	</visual>
	<collision>
		<origin xyz="0.0 0.0 0.0"  rpy="0.0 0.0 0.0"/>
		<geometry>
			<cylinder radius="${props['cylinder_radius']}" length="${props['cylinder_length']}"/>
		</geometry>
	</collision>
</link>

<link name="lower_arm_${arm_num}">
	<inertial>
		<origin xyz="0.0 0.0 0.0"/>	
		<mass value="${props_inertial['big_box_mass']}"/>
		<inertia ixx="${BigBox_xx}" ixy="${BigBox_xy}" ixz="${BigBox_xz}" iyy="${BigBox_xx}" iyz="${BigBox_yz}" izz="${BigBox_zz}"/>
	</inertial>
	<visual>
		<origin xyz="${props['big_box_length'] / 2} 0.0 0.0"  rpy="0.0 0.0 0.0"/>
		<geometry>
			<box size="${props['big_box_length']} ${props['big_box_width']} ${props['big_box_height']}"/>
		</geometry>
	</visual>

	<collision>
		<origin xyz="${props['big_box_length'] / 2} 0.0 0.0"  rpy="0.0 0.0 0.0"/>
		<geometry>
			<box size="${props['big_box_length']} ${props['big_box_width']} ${props['big_box_height']}"/>
		</geometry>
	</collision>
</link>

<link name="elbow_pitch_motor_${arm_num}">
	<inertial>
		<origin xyz="0.0 0.0 0.0"/>
		<mass value="${props_inertial['motorA_mass']}"/>
		<inertia ixx="${MotorA_xx}" ixy="${MotorA_xy}" ixz="${MotorA_xz}" iyy="${MotorA_yy}" iyz="${MotorA_yz}" izz="${MotorA_zz}"/>
	</inertial>
	<visual>
		<origin xyz="0.0 0.0 0.0"  rpy="0.0 0.0 0.0"/>
	  	<geometry>
	 		<cylinder radius="${props['cylinder_radius']}" length="${props['cylinder_length']}"/>
	  	</geometry>
  		<material name="dark_grey"/>
	</visual>
	<collision>
		<origin xyz="0.0 0.0 0.0"  rpy="0.0 0.0 0.0"/>
		<geometry>
			<cylinder radius="${props['cylinder_radius']}" length="${props['cylinder_length']}"/>
		</geometry>
	</collision>
</link>

<link name="upper_arm_${arm_num}">
	<inertial>
		<origin xyz="0.0 0.0 0.0"/>	
		<mass value="${props_inertial['small_box_mass']}"/>
		<inertia ixx="${SmallBox_xx}" ixy="${SmallBox_xy}" ixz="${SmallBox_xz}" iyy="${SmallBox_xx}" iyz="${SmallBox_yz}" izz="${SmallBox_zz}"/>
	</inertial>
	<visual>
		<origin xyz="${props['small_box_length'] / 2} 0.0 0.0"  rpy="0.0 0.0 0.0"/>
		<geometry>
			<box size="${props['small_box_length']} ${props['small_box_width']} ${props['small_box_height']}"/>
		</geometry>
		<material name="dark_grey"/>
	</visual>

	<collision>
		<origin xyz="${props['small_box_length'] / 2} 0.0 0.0"  rpy="0.0 0.0 0.0"/>
		<geometry>
			<box size="${props['small_box_length']} ${props['small_box_width']} ${props['small_box_height']}"/>
		</geometry>
	</collision>
</link>
<!-- /shoulder-elbow -->

<link name="ball_arm_${arm_num}">
    <inertial>
		<origin xyz="0.0 0.0 0.0"/>
		<mass value="${props_inertial['ball_mass']}"/>
		<inertia ixx="${Ball_xx}" ixy="${Ball_xy}" ixz="${Ball_xz}" iyy="${Ball_yy}" iyz="${Ball_yz}" izz="${Ball_zz}"/>
	</inertial>
	<visual>
		<origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
		<geometry>
			<sphere radius="${props['ball_radius']}"/>
		</geometry>
	</visual>
	<collision>
		<origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
		<geometry>
			<sphere radius="${props['ball_radius']}"/>
		</geometry>
	</collision>
</link>

<!-- /LINKS -->

<!-- JOINTS -->
<!-- shoulder yaw -->
<joint name="shoulder_yaw_${arm_num}" type="revolute">
	<parent link="${parent}"/>
	<child link="shoulder_yaw_motor_${arm_num}"/>
	<origin xyz="${props['ShoulderYaw_Ox'] / 2 -0.1} ${rot*props['ShoulderYaw_Oy'] / 2 - rot*0.05} ${props['ShoulderYaw_Oz'] / 2}" rpy="${props['ShoulderYaw_roll']} ${props['ShoulderYaw_pitch']} ${props['ShoulderYaw_yaw']}"/>
	<axis xyz="0 0 1"/>
	<limit lower="${j_shoulder_yaw_lower[arm_num-1]}" upper="${j_shoulder_yaw_upper[arm_num-1]}" effort="${j_shoulder_torque[arm_num-1]}" velocity="${j_shoulder_velocity[arm_num-1]}"/>
</joint>

<joint name="shoulder_pitch_stator_${arm_num}" type="fixed">
	<parent link="shoulder_yaw_motor_${arm_num}"/>
	<child link="shoulder_pitch_motor_${arm_num}"/>
	<origin xyz="${props['ShoulderPitch_Ox']} ${props['ShoulderPitch_Oy']} ${props['ShoulderPitch_Oz'] / 2}" rpy="${-props['ShoulderPitch_roll']} ${props['ShoulderPitch_pitch']} ${props['ShoulderPitch_yaw']}"/>
</joint>
	
<!-- arm pitch 1 -->
<joint name="shoulder_pitch_${arm_num}" type="revolute">
	<parent link="shoulder_pitch_motor_${arm_num}"/>
	<child link="lower_arm_${arm_num}"/>
	<origin xyz="${props['LowerArm_Ox']} ${props['LowerArm_Oy']} ${props['LowerArm_Oz'] / 2}" rpy="${props['LowerArm_roll']} ${props['LowerArm_pitch']} ${-props['LowerArm_yaw']}"/>
	<axis xyz="0 0 1"/>
	<limit lower="${j_pitch_1_lower[arm_num-1]}" upper="${j_pitch_1_upper[arm_num-1]}" effort="${j_pitch_1_torque[arm_num-1]}" velocity="${j_pitch_1_velocity[arm_num-1]}"/>
</joint>

<joint name="elbow_pitch_stator_${arm_num}" type="fixed">
	<parent link="lower_arm_${arm_num}"/>
	<child link="elbow_pitch_motor_${arm_num}"/>
	<origin xyz="${props['ElbowPitch_Ox']} ${props['ElbowPitch_Oy']} ${props['ElbowPitch_Oz']}" rpy="${props['ElbowPitch_roll']} ${props['ElbowPitch_pitch']} ${props['ElbowPitch_yaw']}"/>
</joint>

<!-- arm pitch 2 -->
<joint name="elbow_pitch_${arm_num}" type="revolute">
	<parent link="elbow_pitch_motor_${arm_num}"/>
	<child link="upper_arm_${arm_num}"/>
	<origin xyz="${props['UpperArm_Ox']} ${props['UpperArm_Oy']} ${props['UpperArm_Oz']}" rpy="${props['UpperArm_roll']} ${props['UpperArm_pitch']} ${props['UpperArm_yaw']}"/>
	<axis xyz="0 0 1"/>
	<limit lower="${j_pitch_2_lower[arm_num-1]}" upper="${j_pitch_2_upper[arm_num-1]}" effort="${j_pitch_2_torque[arm_num-1]}" velocity="${j_pitch_2_velocity[arm_num-1]}"/>
</joint>
	
<!-- end effector  -->
<joint name="hand_joint_${arm_num}" type="fixed">
	<parent link="upper_arm_${arm_num}"/>
	<child link="ball_arm_${arm_num}"/>
	<origin xyz="${props['EndEffector_Ox']} ${props['EndEffector_Oy']} ${props['EndEffector_Oz']}" rpy="${props['EndEffector_roll']} ${props['EndEffector_pitch']} ${props['EndEffector_yaw']}"/>
</joint>

</xacro:macro>
<!-- /macro arms -->

</robot>
