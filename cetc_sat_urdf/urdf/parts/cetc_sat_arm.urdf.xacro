<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">

<xacro:include filename="$(find dagana_urdf)/urdf/dagana_macro.urdf.xacro"/>

<!-- macro arms -->
<xacro:macro name="cetc_sat_arm" params="arm_num rot parent">
	
<!-- LINKS -->
<!-- shoulder yaw -->
<link name="shoulder_yaw_motor_${arm_num}">
	<inertial>
		<origin xyz="0.0 0.0 0.0"/>
		<mass value="${motorA_mass}"/>
		<inertia ixx="${MotorA_xx}" ixy="${MotorA_xy}" ixz="${MotorA_xz}" iyy="${MotorA_yy}" iyz="${MotorA_yz}" izz="${MotorA_zz}"/>
	</inertial>
	<visual>
		<origin xyz="0.0 0.0 0.0"  rpy="0.0 0.0 0.0"/>
		<geometry>
			<cylinder radius="${cylinder_radius}" length="${cylinder_length}"/>
		</geometry>
		<material name="dark_grey"/>
	</visual>
	<collision>
		<origin xyz="0.0 0.0 0.0"  rpy="0.0 0.0 0.0"/>
		<geometry>
			<cylinder radius="${cylinder_radius}" length="${cylinder_length}"/>
		</geometry>
	</collision>
</link>

<link name="shoulder_pitch_motor_${arm_num}">
	<inertial>
		<origin xyz="0.0 0.0 0.0"/>
		<mass value="${motorA_mass}"/>
		<inertia ixx="${MotorA_xx}" ixy="${MotorA_xy}" ixz="${MotorA_xz}" iyy="${MotorA_yy}" iyz="${MotorA_yz}" izz="${MotorA_zz}"/>
	</inertial>
	<visual>
		<origin xyz="0.0 0.0 0.0"  rpy="0.0 0.0 0.0"/>
	  	<geometry>
	 		<cylinder radius="${cylinder_radius}" length="${cylinder_length}"/>
	  	</geometry>
  		<material name="dark_grey"/>
	</visual>
	<collision>
		<origin xyz="0.0 0.0 0.0"  rpy="0.0 0.0 0.0"/>
		<geometry>
			<cylinder radius="${cylinder_radius}" length="${cylinder_length}"/>
		</geometry>
	</collision>
</link>

<link name="lower_arm_${arm_num}">
	<inertial>
		<origin xyz="${lower_arm_length / 2} 0.0 0.0"/>	
		<mass value="${lower_arm_mass}"/>
		<inertia ixx="${LowerArm_xx}" ixy="${LowerArm_xy}" ixz="${LowerArm_xz}" iyy="${LowerArm_yy}" iyz="${LowerArm_yz}" izz="${LowerArm_zz}"/>
	</inertial>
	<visual>
		<origin xyz="${lower_arm_length / 2} 0.0 0.0"  rpy="0.0 0.0 0.0"/>
		<geometry>
			<box size="${lower_arm_length} ${lower_arm_width} ${lower_arm_height}"/>
		</geometry>
	</visual>
	<collision>
		<origin xyz="${lower_arm_length / 2} 0.0 0.0"  rpy="0.0 0.0 0.0"/>
		<geometry>
			<box size="${lower_arm_length} ${lower_arm_width} ${lower_arm_height}"/>
		</geometry>
	</collision>
</link>

<link name="elbow_pitch_motor_${arm_num}">
	<inertial>
		<origin xyz="0.0 0.0 0.0"/>
		<mass value="${motorA_mass}"/>
		<inertia ixx="${MotorA_xx}" ixy="${MotorA_xy}" ixz="${MotorA_xz}" iyy="${MotorA_yy}" iyz="${MotorA_yz}" izz="${MotorA_zz}"/>
	</inertial>
	<visual>
		<origin xyz="0.0 0.0 0.0"  rpy="0.0 0.0 0.0"/>
	  	<geometry>
	 		<cylinder radius="${cylinder_radius}" length="${cylinder_length}"/>
	  	</geometry>
  		<material name="dark_grey"/>
	</visual>
	<collision>
		<origin xyz="0.0 0.0 0.0"  rpy="0.0 0.0 0.0"/>
		<geometry>
			<cylinder radius="${cylinder_radius}" length="${cylinder_length}"/>
		</geometry>
	</collision>
</link>

<link name="upper_arm1_${arm_num}">
	<inertial>
		<origin xyz="${upper_arm1_length / 2} 0.0 0.0"/>	
		<mass value="${upper_arm1_mass}"/>
		<inertia ixx="${UpperArm1_xx}" ixy="${UpperArm1_xy}" ixz="${UpperArm1_xz}" iyy="${UpperArm1_yy}" iyz="${UpperArm1_yz}" izz="${UpperArm1_zz}"/>
	</inertial>
	<visual>
		<origin xyz="${upper_arm1_length / 2} 0.0 0.0"  rpy="0.0 0.0 0.0"/>
		<geometry>
			<box size="${upper_arm1_length} ${upper_arm1_width} ${upper_arm1_height}"/>
		</geometry>
	</visual>
	<collision>
		<origin xyz="${lower_arm_length / 2} 0.0 0.0"  rpy="0.0 0.0 0.0"/>
		<geometry>
			<box size="${upper_arm1_length} ${upper_arm1_width} ${upper_arm1_height}"/>
		</geometry>
	</collision>
</link>

<link name="wrist_pitch_motor_${arm_num}">
	<inertial>
		<origin xyz="0.0 0.0 0.0"/>
		<mass value="${motorA_mass}"/>
		<inertia ixx="${MotorA_xx}" ixy="${MotorA_xy}" ixz="${MotorA_xz}" iyy="${MotorA_yy}" iyz="${MotorA_yz}" izz="${MotorA_zz}"/>
	</inertial>
	<visual>
		<origin xyz="0.0 0.0 0.0"  rpy="0.0 0.0 0.0"/>
	  	<geometry>
	 		<cylinder radius="${cylinder_radius / 2}" length="${cylinder_length / 2}"/>
	  	</geometry>
  		<material name="dark_grey"/>
	</visual>
	<collision>
		<origin xyz="0.0 0.0 0.0"  rpy="0.0 0.0 0.0"/>
		<geometry>
			<cylinder radius="${cylinder_radius}" length="${cylinder_length}"/>
		</geometry>
	</collision>
</link>

<link name="upper_arm2_${arm_num}">
	<inertial>
		<origin xyz="${upper_arm2_length / 2} 0.0 0.0"/>	
		<mass value="${upper_arm2_mass}"/>
		<inertia ixx="${UpperArm2_xx}" ixy="${UpperArm2_xy}" ixz="${UpperArm2_xz}" iyy="${UpperArm2_yy}" iyz="${UpperArm2_yz}" izz="${UpperArm2_zz}"/>
	</inertial>
	<visual>
		<origin xyz="${upper_arm2_length / 2} 0.0 0.0"  rpy="0.0 0.0 0.0"/>
		<geometry>
			<box size="${upper_arm2_length} ${upper_arm2_width} ${upper_arm2_height}"/>
		</geometry>
	</visual>
	<collision>
		<origin xyz="${upper_arm1_length / 2} 0.0 0.0"  rpy="0.0 0.0 0.0"/>
		<geometry>
			<box size="${upper_arm2_length} ${upper_arm2_width} ${upper_arm2_height}"/>
		</geometry>
	</collision>
</link>>
<!-- /shoulder-elbow -->

<link name="wrist_${arm_num}">
	<inertial>
		<origin xyz="0.0 0.0 0.0"/>
		<mass value="${motorA_mass}"/>
		<inertia ixx="${MotorA_xx}" ixy="${MotorA_xy}" ixz="${MotorA_xz}" iyy="${MotorA_yy}" iyz="${MotorA_yz}" izz="${MotorA_zz}"/>
	</inertial>
	<visual>
		<origin xyz="0.0 0.0 0.0"  rpy="0.0 0.0 0.0"/>
	  	<geometry>
	 		<cylinder radius="${cylinder_radius}" length="${cylinder_length / 6}"/>
	  	</geometry>
  		<material name="dark_grey"/>
	</visual>
	<collision>
		<origin xyz="0.0 0.0 0.0"  rpy="0.0 0.0 0.0"/>
		<geometry>
			<cylinder radius="${cylinder_radius/2}" length="${cylinder_length/2}"/>
		</geometry>
	</collision>
</link>

<!--link name="ball_arm_${arm_num}">
	<inertial>
		<origin xyz="0.0 0.0 0.0"/>
		<mass value="${ball_mass}"/>
		<inertia ixx="${Ball_xx}" ixy="${Ball_xy}" ixz="${Ball_xz}" iyy="${Ball_yy}" iyz="${Ball_yz}" izz="${Ball_zz}"/>
	</inertial>
	<visual>
		<origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
		<geometry>
			<sphere radius="${ball_radius}"/>
		</geometry>
	</visual>
	<collision>
		<origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
		<geometry>
			<sphere radius="${ball_radius}"/>
		</geometry>
	</collision>
</link-->


<xacro:dagana_gripper name="dagana_${arm_num}" parent_link="wrist_${arm_num}" joint_type="fixed">
	<origin xyz="0 0 0" rpy="0 0 0"/>
</xacro:dagana_gripper>

<!-- /LINKS -->

<!-- JOINTS -->
<!-- shoulder yaw -->
<joint name="shoulder_yaw_${arm_num}" type="revolute">
	<parent link="${parent}"/>
	<child link="shoulder_yaw_motor_${arm_num}"/>
	<origin xyz="${ShoulderYaw_Ox - ShoulderYaw_OffsetX} ${rot * ShoulderYaw_Oy - rot * ShoulderYaw_OffsetY} ${ShoulderYaw_Oz - ShoulderYaw_OffsetZ}" rpy="${-rot * ShoulderYaw_roll} ${ShoulderYaw_pitch} ${ShoulderYaw_yaw}"/>
	<axis xyz="0 0 1"/>
	<limit lower="${j_shoulder_yaw_lower[arm_num-1]}" upper="${j_shoulder_yaw_upper[arm_num-1]}" effort="${motor_effort}" velocity="${motor_velocity}"/>
</joint>

<joint name="shoulder_pitch_stator_${arm_num}" type="fixed">
	<parent link="shoulder_yaw_motor_${arm_num}"/>
	<child link="shoulder_pitch_motor_${arm_num}"/>
	<origin xyz="${ShoulderPitch_Ox} ${ShoulderPitch_Oy} ${ShoulderPitch_Oz}" rpy="${ShoulderPitch_roll} ${ShoulderPitch_pitch} ${ShoulderPitch_yaw}"/>
</joint>
	
<!-- arm pitch 1 -->
<joint name="shoulder_pitch_${arm_num}" type="revolute">
	<parent link="shoulder_pitch_motor_${arm_num}"/>
	<child link="lower_arm_${arm_num}"/>
	<origin xyz="${LowerArm_Ox} ${LowerArm_Oy} ${LowerArm_Oz}" rpy="${LowerArm_roll} ${LowerArm_pitch} ${LowerArm_yaw}"/>
	<axis xyz="0 0 1"/>
	<limit lower="${j_pitch_1_lower[arm_num-1]}" upper="${j_pitch_1_upper[arm_num-1]}" effort="${motor_effort}" velocity="${motor_velocity}"/>
</joint>

<joint name="elbow_pitch_stator_${arm_num}" type="fixed">
	<parent link="lower_arm_${arm_num}"/>
	<child link="elbow_pitch_motor_${arm_num}"/>
	<origin xyz="${ElbowPitch_Ox} ${ElbowPitch_Oy} ${ElbowPitch_Oz}" rpy="${ElbowPitch_roll} ${ElbowPitch_pitch} ${ElbowPitch_yaw}"/>
</joint>

<!-- arm pitch 2 -->
<joint name="elbow_pitch_${arm_num}" type="revolute">
	<parent link="elbow_pitch_motor_${arm_num}"/>
	<child link="upper_arm1_${arm_num}"/>
	<origin xyz="${UpperArm1_Ox} ${UpperArm1_Oy} ${UpperArm1_Oz}" rpy="${UpperArm1_roll} ${UpperArm1_pitch} ${UpperArm1_yaw}"/>
	<axis xyz="0 0 1"/>
	<limit lower="${j_pitch_2_lower[arm_num-1]}" upper="${j_pitch_2_upper[arm_num-1]}" effort="${motor_effort}" velocity="${motor_velocity}"/>
</joint>

<joint name="wrist_pitch_stator_${arm_num}" type="fixed">
	<parent link="upper_arm1_${arm_num}"/>
	<child link="wrist_pitch_motor_${arm_num}"/>
	<origin xyz="${WristPitch_Ox} ${WristPitch_Oy} ${WristPitch_Oz}" rpy="${WristPitch_roll} ${WristPitch_pitch} ${WristPitch_yaw}"/>
</joint>

<joint name="wrist_pitch_${arm_num}" type="revolute">
	<parent link="wrist_pitch_motor_${arm_num}"/>
	<child link="upper_arm2_${arm_num}"/>
	<origin xyz="${UpperArm2_Ox} ${UpperArm2_Oy} ${UpperArm2_Oz}" rpy="${UpperArm2_roll} ${UpperArm2_pitch} ${UpperArm2_yaw}"/>
	<axis xyz="0 0 1"/>
	<limit lower="${j_pitch_2_lower[arm_num-1]}" upper="${j_pitch_2_upper[arm_num-1]}" effort="${motor_effort}" velocity="${motor_velocity}"/>
</joint>
	
<!-- end effector  -->
<joint name="wrist_yaw_${arm_num}" type="revolute">
	<parent link="upper_arm2_${arm_num}"/>
	<child link="wrist_${arm_num}"/>
	<origin xyz="${EndEffector_Ox} ${EndEffector_Oy} ${EndEffector_Oz}" rpy="${EndEffector_roll} ${EndEffector_pitch} ${EndEffector_yaw}"/>
	<axis xyz="0 0 1"/>
	<limit lower="${j_pitch_2_lower[arm_num-1]}" upper="${j_pitch_2_upper[arm_num-1]}" effort="${motor_effort}" velocity="${motor_velocity}"/>
</joint>

<!--joint name="hand_joint_${arm_num}" type="fixed">
	<parent link="wrist_${arm_num}"/>
	<child link="ball_arm_${arm_num}"/>
	<origin xyz="0 0 ${ball_radius}" rpy="0 0 0"/>
</joint-->

