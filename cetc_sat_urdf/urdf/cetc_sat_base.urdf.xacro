<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro" name="cetc_sat">

<xacro:include filename="$(find cetc_sat_urdf)/urdf/utils.urdf.xacro" />
<xacro:include filename="$(find cetc_sat_urdf)/urdf/parts/kinematics_properties.urdf.xacro" />
<xacro:include filename="$(find cetc_sat_urdf)/urdf/parts/inertial_properties.urdf.xacro" />
<xacro:include filename="$(find cetc_sat_urdf)/urdf/parts/limits.urdf.xacro" />

<xacro:arg name="bilevel_codes" default="false" /> <!-- if true, load codes vars from externally provided files-->
<xacro:arg name="inertial_props_path" default="$(find cetc_sat_urdf)/urdf/config/kinematics_properties.yaml" /> 
<xacro:arg name="kinematic_props_path" default="$(find cetc_sat_urdf)/urdf/config/inertial_properties.yaml" />

<xacro:property name="yaml_file_inertial" value="$(arg inertial_props_path)" />
<xacro:property name="yaml_file" value="$(arg kinematic_props_path)" />

<xacro:property name="props_inertial" value="${xacro.load_yaml(yaml_file_inertial)}"/>
<xacro:property name="props" value="${xacro.load_yaml(yaml_file)}"/>

<link name="base_link"/>

<link name="pelvis">
	<inertial>
		<origin xyz="0.0 0.0 0.0"/>
		<mass value="${props_inertial['pelvis_mass']}"/>
		<inertia ixx="${Pelvis_xx}" ixy="${Pelvis_xy}" ixz="${Pelvis_xz}" iyy="${Pelvis_yy}" iyz="${Pelvis_yz}" izz="${Pelvis_zz}"/>
	</inertial>
	<visual>
		<origin xyz="0.0 0 0.0"  rpy="0.0 0.0 0.0"/>
		<geometry>
	 		<box size="${pelvis_length} ${pelvis_width} ${pelvis_height}"/>
	 		<!--mesh filename="package://cetc_sat_urdf/meshes/mesh_pelvis.stl" scale="0.001 0.001 0.001"/-->
		</geometry>
	</visual>
	<collision>
		<origin xyz="0.0 0 0.0"  rpy="0.0 0.0 0.0"/>
		<geometry>
	  		<box size="${pelvis_length} ${pelvis_width} ${pelvis_height}"/>
	  		<!--mesh filename="package://cetc_sat_urdf/meshes/mesh_pelvis.stl" scale="0.001 0.001 0.001"/-->
		</geometry>
	</collision>
</link>

<joint name="base_joint" type="fixed">
    <parent link="pelvis"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0" />
</joint>

<xacro:if value="${ADD_SENSORS}">
    <xacro:include filename="$(find realsense_gazebo_description)/urdf/_d435i.urdf.xacro" />

    <!-- LEFT D435 CAMERA -->
    <xacro:sensor_d435i parent="pelvis"
        name="D435_left"
        topics_ns="D435_left"
        enable_pointCloud="true"
        align_depth="true"
        unite_imu_method="false"
        visualize="true"
        accel_fps="300"
        gyro_fps="300"
        depth_width="1280"
        depth_height="720"
        depth_fps="90"
        infra_width="1280"
        infra_height="720"
        infra_fps="90"
        color_width="1280"
        color_height="720"
        color_fps="30">

        <origin xyz="-0.175 0.22 0" rpy="0 0.35 1.57"/>

    </xacro:sensor_d435i>

    <!-- RIGHT D435 CAMERA -->
    <xacro:sensor_d435i parent="pelvis"
        name="D435_right"
        topics_ns="D435_right"
        enable_pointCloud="true"
        align_depth="true"
        unite_imu_method="false"
        visualize="true"
        accel_fps="300"
        gyro_fps="300"
        depth_width="1280"
        depth_height="720"
        depth_fps="90"
        infra_width="1280"
        infra_height="720"
        infra_fps="90"
        color_width="1280"
        color_height="720"
        color_fps="30">

        <origin xyz="-0.175 -0.22 0" rpy="0 0.35 -1.57"/>

    </xacro:sensor_d435i>

    <!-- REAR D435 CAMERA -->
    <xacro:sensor_d435i parent="pelvis"
        name="D435_rear"
        topics_ns="D435_rear"
        enable_pointCloud="true"
        align_depth="true"
        unite_imu_method="false"
        visualize="true"
        accel_fps="300"
        gyro_fps="300"
        depth_width="1280"
        depth_height="720"
        depth_fps="90"
        infra_width="1280"
        infra_height="720"
        infra_fps="90"
        color_width="1280"
        color_height="720"
        color_fps="30">

        <origin xyz="-0.39 0 0" rpy="0 0.35 3.14"/>

    </xacro:sensor_d435i>

    <!-- FRONT1 D435 CAMERA -->
    <xacro:sensor_d435i parent="pelvis"
        name="D435_front1"
        topics_ns="D435_front1"
        enable_pointCloud="true"
        align_depth="true"
        unite_imu_method="false"
        visualize="true"
        accel_fps="300"
        gyro_fps="300"
        depth_width="1280"
        depth_height="720"
        depth_fps="90"
        infra_width="1280"
        infra_height="720"
        infra_fps="90"
        color_width="1280"
        color_height="720"
        color_fps="30">

        <origin xyz="0.40 -0.08 0" rpy="-1.57 0 0.34"/>

    </xacro:sensor_d435i>

    <!-- FRONT2 D435 CAMERA -->
    <xacro:sensor_d435i parent="pelvis"
        name="D435_front2"
        topics_ns="D435_front2"
        enable_pointCloud="true"
        align_depth="true"
        unite_imu_method="false"
        visualize="true"
        accel_fps="300"
        gyro_fps="300"
        depth_width="1280"
        depth_height="720"
        depth_fps="90"
        infra_width="1280"
        infra_height="720"
        infra_fps="90"
        color_width="1280"
        color_height="720"
        color_fps="30">

        <origin xyz="0.40 0.08 0" rpy="-1.57 0 -0.34"/>

    </xacro:sensor_d435i>

    <!-- FRONT3 (down) D435 CAMERA -->
    <xacro:sensor_d435i parent="pelvis"
        name="D435_front3"
        topics_ns="D435_front3"
        enable_pointCloud="true"
        align_depth="true"
        unite_imu_method="false"
        visualize="true"
        accel_fps="300"
        gyro_fps="300"
        depth_width="1280"
        depth_height="720"
        depth_fps="90"
        infra_width="1280"
        infra_height="720"
        infra_fps="90"
        color_width="1280"
        color_height="720"
        color_fps="30">

        <origin xyz="0.37 0 -0.11" rpy="0 0.75 0"/>

    </xacro:sensor_d435i>
    <!-- Velodyne -->
    <xacro:include filename="$(find velodyne_description)/urdf/VLP-16.urdf.xacro"/>
    <xacro:VLP-16 parent="pelvis" name="velodyne" topic="/velodyne_points" hz="10" samples="440">
        <origin xyz="0.36 0 0.11" rpy="0 0 0" />
    </xacro:VLP-16>

</xacro:if>

<xacro:if value="${ADD_UPPER_BODY}">
    <xacro:include filename="$(find cetc_sat_urdf)/urdf/parts/arms.urdf.xacro" />
</xacro:if>

<xacro:if value="${ADD_LEGS}">
	<xacro:include filename="$(find cetc_sat_urdf)/urdf/parts/legs.urdf.xacro" />
</xacro:if>

</robot>

