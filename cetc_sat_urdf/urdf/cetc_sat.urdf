      <always_on>1</always_on>
      <update_rate>90</update_rate>
      <visualize>false</visualize>
    </sensor>
    <sensor name="D435_front3depth" type="depth">
      <camera name="D435_front3">
        <horizontal_fov>1.2112585008840648</horizontal_fov>
        <image>
          <width>1280</width>
          <height>720</height>
