  </gazebo>
  <!-- Camera Center -->
  <link name="zedx_front2_camera_center">
    <inertial>
      <mass value="0.16140"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.0003947" ixy="0.0" ixz="3.3365e-8" iyy="2.417e-5" iyz="0.0" izz="0.0003973"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0"/>
      <geometry>
        <box size="0.030 0.094 0.037"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0"/>
      <geometry>
        <box size="0.094 0.030 0.037"/>
      </geometry>
    </collision>
  </link>
  <joint name="zedx_front2_base_joint" type="fixed">
    <origin rpy="-1.57 0 -0.5" xyz="0.40 -0.065 0"/>
    <parent link="pelvis"/>
    <child link="zedx_front2_camera_center"/>
  </joint>
  <!-- Left Camera -->
  <joint name="zedx_front2_left_camera_joint" type="fixed">
